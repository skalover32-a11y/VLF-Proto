# VLF Transit (hop) production env example.
#
# Copy to /etc/vlf-transit/.env and customize. Never commit real secrets.
# All Phase-1 risky transport flags MUST stay 0 until canary signs off.

# --- Pinned deployment ---
# Always pin to a tag or commit sha. Never leave this on "main" in production.
VLF_TRANSIT_REF=
VLF_TRANSIT_REPO_URL=https://github.com/skalover32-a11y/VLF-Proto.git
VLF_TRANSIT_INSTALL_DIR=/opt/vlf-proto-transit
# Mirror values for the Phase-1 wrapper (scripts/update-transit.sh).
VLF_REF=
VLF_REPO_URL=https://github.com/skalover32-a11y/VLF-Proto.git

# --- Phase-1 safety flags (MUST be 0 in canary phase 1) ---
VLF_TRANSPORT_PROFILES_ENABLED=0
VLF_PROFILE_SCORING_ENABLED=0
VLF_PROFILE_MIGRATION_ENABLED=0
VLF_RESUME_TOKENS_ENABLED=0

# --- Origin gateway target (placeholders; replace with real values on host) ---
# VLF_TRANSIT_BACKEND_HOST=gateway.example.com
# VLF_TRANSIT_BACKEND_TCP_PORT=443
# VLF_TRANSIT_BACKEND_UDP_PORT=443
# VLF_TRANSIT_BACKEND_RELAY_PORT=8080
