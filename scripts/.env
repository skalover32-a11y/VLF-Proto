# VLF-Proto Windows Test Runner config
# Put this .env next to vlf-test-runner.ps1

# Mode: External (real Windows) is what you want
MODE=External

# Public endpoint of your gateway
GATEWAY_HOST=troynichek-live.ru
GATEWAY_PORT_UDP=8443
GATEWAY_PORT_TCP=443
# legacy fallback if *_UDP/*_TCP are not set:
# GATEWAY_PORT=443

# HTTP relay base URL
RELAY_BASE=http://troynichek-live.ru:8080

# Client auth (HMAC)
VLF_CLIENT=smoke-client
VLF_CLIENT_ID=smoke-client
VLF_SECRET=smoke-secret
# or base64 format:
# VLF_SECRET=b64:c21va2Utc2VjcmV0

# TLS pinning (base64 SPKI pin). Leave empty to skip wrong-pin negative test.
VLF_PIN_SPKI=OVj3omf993LctzE5QIO8PCp3UNhVgL2CRm8d1gQRCk8=

# QUIC tuning
MAX_DGRAM_PAYLOAD=1200
VLF_DEBUG=1
# Set to 1 to forbid relay fallback in session_smoke (negative tests).
VLF_DISABLE_RELAY_FALLBACK=0

# Build smoke binaries from Go sources (requires go or docker)
BUILD=1
SESSION_GO=session_smoke.go
RELAY_GO=relay_smoke.go

# Paths (optional)
WORK_DIR=.
OUT_DIR=./out
#SESSION_EXE=./out/session_smoke.exe
#RELAY_EXE=./out/relay_smoke.exe

# Keep window open? (0/1)
NO_PAUSE=0
