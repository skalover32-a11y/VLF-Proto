# VLF-Proto gateway installer/runtime environment template
# Copy reference only. Real production file is created by scripts/install.sh:
#   /etc/vlf-proto/.env

# Repo/deploy metadata
VLF_REPO_URL=https://github.com/skalover32-a11y/VLF-Proto.git
VLF_REF=main
VLF_INSTALL_DIR=/opt/vlf-proto

# Runtime files
VLF_CONFIG_FILE=/etc/vlf-proto/config.yaml
VLF_CERT_FILE=/etc/vlf-proto/tls.crt
VLF_KEY_FILE=/etc/vlf-proto/tls.key

# Public endpoint data (autodetected by installer)
VLF_PUBLIC_IPV4=203.0.113.10
VLF_PUBLIC_IPV6=

# Optional domain/SNI (domain mode)
VLF_DOMAIN=
VLF_TLS_SERVER_NAME=

# Session ports
VLF_PORT_TCP=443
VLF_PORT_UDP=443
VLF_PORT_UDP_ALT=8443

# Relay + metrics bind
VLF_METRICS_ADDR=127.0.0.1
VLF_METRICS_PORT=8080
VLF_ENABLE_METRICS=1

# Logging/protocol
VLF_LOG_LEVEL=info
VLF_PROTOCOL_ID=vlf-runtime/0.1
VLF_UDP_PPS_HOLD_SECONDS=3

# Auth secrets
VLF_CLIENT_ID=gateway-client
VLF_CLIENT_SECRET=replace-with-secure-random

# Convenience relay URLs
VLF_RELAY_BASE_IP=http://203.0.113.10:8080
VLF_RELAY_BASE_DOMAIN=
